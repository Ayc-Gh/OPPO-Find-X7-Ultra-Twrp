# SPDX-License-Identifier: Apache-2.0
import /init.recovery.wifi.rc

on early-fs
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice} 10
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 system system
    install_keyring

on property:twrp.phy110.predecrypt=1
    # The pinned bootable/recovery patch mounts the stock ABI partitions before
    # this trigger and waits for twrp.phy110.crypto=ready before FBE decryption.
    exec - root root -- /system/bin/sh /system/bin/load-phy110-modules.sh base
    exec - root root -- /system/bin/sh /system/bin/prepare-phy110-stock.sh

    # If stock init services were parsed in this boot mode, stop their Android
    # domains before launching the recovery-domain wrappers below.
    stop vendor.qseecomd
    stop qseecom-service
    stop vendor.keymint-qti
    stop vendor.gatekeeper_default
    stop vendor.weaver_nxp
    stop vendor.boot-qti
    stop vendor.health-default
    setprop twrp.phy110.services prepared

on property:twrp.phy110.stock.boot=present
    start phy110-boot-qti

on property:twrp.phy110.stock.health=present
    start phy110-health

on property:twrp.phy110.stock.crypto=ready
    setprop twrp.phy110.crypto starting-qsee
    start phy110-qseecomd
    start phy110-qseecom-aidl

on property:init.svc.phy110-qseecomd=running && property:init.svc.phy110-qseecom-aidl=running
    setprop twrp.phy110.crypto starting-key-services
    start phy110-keymint-qti
    start phy110-gatekeeper
    start phy110-weaver

on property:init.svc.phy110-keymint-qti=running && property:init.svc.phy110-gatekeeper=running && property:init.svc.phy110-weaver=running
    setprop twrp.phy110.crypto ready
    setprop crypto.ready 1

# OTG/PMIC initialization is intentionally after the crypto-ready handshake so
# bounded ADSP waits can never delay the first FBE attempt.
on property:twrp.phy110.crypto=ready
    wait /sys/kernel/boot_adsp/boot 10
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/kernel/boot_adsp/ssr 10
    write /sys/kernel/boot_adsp/ssr 1

on property:twrp.phy110.stock.crypto=degraded
    setprop twrp.phy110.crypto degraded
    setprop crypto.ready 0

on property:servicemanager.ready=true
    setprop sys.boot_completed 1

service phy110-qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service phy110-qseecom-aidl /vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service
    class hal
    user system
    group system drmrpc
    interface aidl vendor.qti.hardware.qseecom
    disabled
    seclabel u:r:recovery:s0

service phy110-keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0

service phy110-gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service phy110-weaver /odm/bin/hw/android.hardware.weaver-service.nxp
    class hal
    user root
    group root drmrpc
    capabilities WAKE_ALARM
    disabled
    seclabel u:r:recovery:s0

service phy110-boot-qti /vendor/bin/hw/android.hardware.boot-service.qti
    class early_hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service phy110-health /vendor/bin/hw/android.hardware.health-service.qti
    class hal
    user root
    group root
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    disabled
    seclabel u:r:recovery:s0
